#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/input/input-event-codes.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <6>;

// | R0C0 | R0C1 | R0C2 | R0C3 | R0C4 | R0C5 |   | R0C0 | R0C1 | R0C2 | R0C3 | R0C4 | R0C5 |
// | R1C0 | R1C1 | R1C2 | R1C3 | R1C4 | R1C5 |   | R1C0 | R1C1 | R1C2 | R1C3 | R1C4 | R1C5 |
// | R2C0 | R2C1 | R2C2 | R2C3 | R2C4 | R2C5 |   | R2C0 | R2C1 | R2C2 | R2C3 | R2C4 | R2C5 |
// | R3C0 | R3C1 | R3C2 | R3C3 | R3C4 | R3C5 |   | R3C0 | R3C1 | R3C2 | R3C3 | R3C4 | R3C5 |
// | R4C0 | R4C1 | R4C2 | R4C3 | R4C4 | R4C5 |   | R4C0 | R4C1 | R4C2 | R4C3 | R4C4 | R4C5 |
//                      | DSW0 | DSW1 | DSW2 |   | DSW0 | DSW1 | DSW2 |  B  |
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)  RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
                        RC(5,0) RC(5,1) RC(5,2)  RC(5,6) RC(5,7) RC(5,8) RC(5,9)
        >;
    };

    kscan0: kscan_composite {
        compatible = "zmk,kscan-composite";
        wakeup-source;
        rows = <6>;
        columns = <6>;

        matrix {
            kscan = <&kscan_matrix>;
        };

        direct {
            kscan = <&kscan_direct>;
            row-offset = <5>;
        };
    };

    alt_thumb_kscan: alt_thumb_kscan {
        compatible = "modu,kscan-alt-thumb-remap";
        status = "disabled";
        wakeup-source;
        kscan = <&kscan0>;
        orientation-gpios = <&gpio0 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    kscan_matrix: kscan_matrix {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0  3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        col-gpios
            = <&gpio1 15 GPIO_ACTIVE_HIGH>
            , <&gpio0  2 GPIO_ACTIVE_HIGH>
            , <&gpio0 29 GPIO_ACTIVE_HIGH>
            , <&gpio0 28 GPIO_ACTIVE_HIGH>
            , <&gpio0 31 GPIO_ACTIVE_HIGH>
            , <&gpio0 27 GPIO_ACTIVE_HIGH>
            ;
    };

    kscan_direct: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;

        input-gpios
            = <&gpio0  5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0  4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 26 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };
};

/ {
    chosen {
        zmk,battery = &vbatt;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 6>;
        output-ohms = <1000>;
        full-ohms = <1000>;
    };
};

/* Status LEDs (PWM breath effect) */
/ {
    pwmleds {
        compatible = "pwm-leds";

        led1: led_1 {
            pwms = <&pwm0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
        };
        led2: led_2 {
            pwms = <&pwm0 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
        };
        led3: led_3 {
            pwms = <&pwm0 2 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
        };
    };

    aliases {
        led-status1 = &led1;
        led-status2 = &led2;
        led-status3 = &led3;
    };
};

/* PMW3610 Trackball - present on both sides */
&spi0 {
    status = "okay";
    cs-gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        compatible = "pixart,pmw3610-alt";
        status = "okay";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <600>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
    };
};

/*
 * Dual trackball wiring:
 * - Central listens to its local trackball directly via `trackball_listener`.
 * - Peripheral forwards its local trackball to central via `trackball_split`,
 *   which the central exposes as an input device for `peripheral_trackball_listener`.
 * Both listeners are disabled here and enabled in the central overlay only.
 */
/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackball>;
    };

    peripheral_trackball_listener: peripheral_trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackball_split>;
    };
};
